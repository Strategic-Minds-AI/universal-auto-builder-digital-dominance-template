{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/academy",
  "framework": null,
  "headers": [
    {
      "source": "/sites/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/studio/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
