{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Universal SitePack v1",
  "type":"object",
  "required":["pack_id","version","source","brand","industry","design","locations","provisioning"],
  "properties":{
    "pack_id":{"type":"string","minLength":3},
    "version":{"type":"string"},
    "source":{"type":"object","required":["repository","commit_sha","template_id"],"properties":{"repository":{"type":"string"},"commit_sha":{"type":"string","minLength":7},"template_id":{"type":"string"}}},
    "brand":{"type":"object","required":["name","contact_phone","legal_business_name"],"properties":{"name":{"type":"string"},"contact_phone":{"type":"string"},"legal_business_name":{"type":"string"},"logo_url":{"type":"string"}}},
    "industry":{"type":"object","required":["slug","services"],"properties":{"slug":{"type":"string"},"services":{"type":"array","minItems":1,"items":{"type":"string"}}}},
    "design":{"type":"object","required":["approved_reference","design_token_version"],"properties":{"approved_reference":{"type":"string"},"design_token_version":{"type":"string"}}},
    "locations":{"type":"array","minItems":1,"items":{"type":"object","required":["city","region","country","verified_service_area","unique_value"],"properties":{"city":{"type":"string"},"region":{"type":"string"},"country":{"type":"string"},"verified_service_area":{"type":"boolean"},"unique_value":{"type":"string","minLength":30}}}},
    "provisioning":{"type":"object","required":["mode","approval_required","noindex_until_validated"],"properties":{"mode":{"enum":["preview"]},"approval_required":{"const":true},"noindex_until_validated":{"const":true}}}
  }
}
